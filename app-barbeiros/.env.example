# Copie para .env (ignorado pelo git) e preencha. Nunca coloque valores aqui.
# Banco local: URL http://127.0.0.1:54321 e ANON_KEY mostrados por `npm run db:status`.
# Celular de verdade na mesma rede: troque 127.0.0.1 pelo IP do computador.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Secrets das Edge Functions (supabase secrets set NOME=valor), nunca no git
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
WHATSAPP_TOKEN=
INSTAGRAM_TOKEN=
ELEVENLABS_API_KEY=
